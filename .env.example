# Copy this file to .env and fill in your own key. Never commit .env.
# Get a Gemini API key at https://aistudio.google.com/apikey — note that the
# free tier can still return 429 RESOURCE_EXHAUSTED until the project has real
# prepay billing funded at ai.studio/projects, regardless of any spend cap set.
GEMINI_API_KEY=AIza...

# Model ID actually used for classification. Verify this is still current
# before relying on it — it has changed once already mid-project.
GEMINI_MODEL=gemini-3.6-flash

PORT=3000

# LAN IP that a visitor's own phone can reach for the QR-code download.
# Auto-detected from the network interfaces if left blank; set this
# explicitly if auto-detection picks the wrong interface. Ignored if
# USE_NGROK is true below.
PUBLIC_HOST=

# Set to true to expose the server via an ngrok tunnel instead of the LAN
# IP above. Use this when the venue's Wi-Fi has client/AP isolation (common
# on campus and public networks) so a phone can't otherwise reach the
# laptop at all. Needs a free ngrok account/token: get one at
# https://dashboard.ngrok.com/get-started/your-authtoken.
# SECURITY: while this is on, the QR URL is reachable from ANY network, not
# just this one — anyone with it can hit the Gemini-backed endpoint and
# burn your API quota. Leave this false for normal local dev/testing and
# only turn it on for an actual demo/exhibition, then stop the server after.
USE_NGROK=false
NGROK_AUTHTOKEN=
# Optional: only set this if you have a reserved static ngrok domain.
# Leave blank to get a random one each time the server starts.
NGROK_DOMAIN=

# How long a result image (and its QR-code URL) stays downloadable before
# it's deleted. This is a deliberate, narrow exception to the app's
# stateless-by-default design — see Sharing / QR Code in the tech spec.
RESULT_TTL_MINUTES=20
